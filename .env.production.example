DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_SITE_ID=1
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_URL=https://yourdomain.com

# Database
DB_ENGINE=postgres
DB_NAME=escrow_project
DB_USER=escrow_user
DB_PASSWORD=strong-password-change-this
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=escrow_project
POSTGRES_USER=escrow_user
POSTGRES_PASSWORD=strong-password-change-this
DB_CONN_MAX_AGE=0
DB_USE_POOL=True
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT=30

# Realtime / channels
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=strong-redis-password-change-this
CELERY_AUCTION_SWEEP_SECONDS=60
CELERY_TASK_ALWAYS_EAGER=False

# Withdrawal (disabled by default until real payout gateway is integrated)
WITHDRAWAL_ENABLED=False
ALLOW_MANUAL_WITHDRAWALS_IN_PRODUCTION=False
PLATFORM_OWNER_USERNAME=
MAINTENANCE_END_AT=

# Cloud media storage
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=auto
AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=True
AWS_MEDIA_URL=

# Stripe
STRIPE_CURRENCY=usd
STRIPE_PUBLIC_KEY=pk_live_key_here
STRIPE_SECRET_KEY=sk_live_key_here
STRIPE_WEBHOOK_SECRET=whsec_real_webhook_secret
ALLOW_TEST_PAYMENT_KEYS_IN_PRODUCTION=False

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@email.com
EMAIL_TIMEOUT=30

# Security (all enabled by default when DEBUG=False)
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
