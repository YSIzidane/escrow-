DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_SITE_ID=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=

# Database
# Option 1: DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/escrow_project
# Option 2: DB_* variables below
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_USE_POOL=False
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT=30

# Realtime / channels
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_AUCTION_SWEEP_SECONDS=60
CELERY_DEADLINE_SWEEP_SECONDS=300
CELERY_TASK_ALWAYS_EAGER=False

# Cloud media storage (optional)
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=auto
AWS_LOCATION=media
AWS_QUERYSTRING_AUTH=False
AWS_MEDIA_URL=
MAINTENANCE_END_AT=

# Stripe
STRIPE_CURRENCY=usd
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=30

# Security
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=same-origin
